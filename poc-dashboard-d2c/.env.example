# ===== Servidor VTEX (Azure) =====
VTEX_SERVER=elxa3sql-customerdata-001.database.windows.net
VTEX_DB=Alfred-Cloud
# Azure NO acepta cuenta de Windows: usuario y clave son obligatorios.
VTEX_USER=
VTEX_PASS=

# ===== Servidor SAP (ODS) =====
SAP_SERVER=clws0156
SAP_DB=161221_ts_ods
# Si el ODS usa tu cuenta de Windows, deja estos dos vacíos.
SAP_USER=
SAP_PASS=

# ===== General =====
FECHA_VALIDADA=2026-07-14
# Revisa "Orígenes de datos ODBC" para saber cuál tienes (17 o 18).
ODBC_DRIVER=ODBC Driver 17 for SQL Server
# DEMO=1 usa datos de ejemplo, sin conexión a SQL.
DEMO=

# ===== Actualizacion en vivo (opcional: estos valores ya son los de fabrica) =====
# Cada cuantos segundos el servidor revisa si entro un pedido nuevo o cambio algo
# (consulta liviana, solo conteos). Mas bajo = se ve mas rapido, pero consulta mas las bases.
REVISAR_CADA_SEGUNDOS=10
# Cada cuantos segundos el navegador pregunta al servidor si hay datos nuevos (no toca las bases).
NAVEGADOR_SEGUNDOS=2
# Recarga completa de respaldo, aunque no se detecte ningun cambio.
RECARGA_MAXIMA_SEGUNDOS=300
# Cuanto tiempo un pedido nuevo se muestra marcado como NUEVO en la tabla.
NUEVO_SEGUNDOS=300

# ===== Maestra de productos (grafico "Ventas por Clasif2" de Pedidos VTEX) =====
# Tabla con el codigo SAP, la clasificacion 2 y el nombre del producto. Si la dejas vacia, el programa la busca solo entre las tablas del ODS
# con nombres parecidos (bi_maestra_producto, dim_producto...) y usa la primera que trae codigo SAP y Clasif2 (la zoom del grafico dice cual).
MAESTRA_TABLA=
# Donde esta la tabla: sap (el ODS) o vtex
MAESTRA_ORIGEN=sap
# Solo si las columnas no se llaman codigoSap / Clasif2 / Descripcion (o parecido)
MAESTRA_COL_SKU=
MAESTRA_COL_CLASIF2=
MAESTRA_COL_PRODUCTO=

# ===== Detalle del pedido y asistente (opcional) =====
# El dashboard adivina las columnas de OrderItems (SKU_Name, Selling_Price...). Si en tu base se llaman distinto, indicalas aqui.
# Si el detalle de un pedido muestra un aviso con las columnas disponibles, copia aqui los nombres que correspondan.
ITEM_COL_DESC=
ITEM_COL_PRECIO=
# VTEX suele guardar los precios en centavos: auto lo detecta; 1 = dividir por 100; 0 = no dividir.
ITEM_PRECIO_CENTAVOS=auto

# Asistente de consultas (el chat del icono de arriba). Sin configurar usa reglas, sin IA y sin internet.
# Con IA_MODO la IA solo traduce la pregunta a un plan; las cifras las calcula siempre el servidor (ver ASISTENTE.md).
#   IA_MODO=ollama      IA_URL=http://localhost:11434   IA_MODELO=qwen2.5:7b
#   IA_MODO=openai      IA_URL=http://localhost:1234/v1 IA_MODELO=nombre-del-modelo   (LM Studio, vLLM, llama.cpp, OpenAI)
#   IA_MODO=anthropic   IA_CLAVE=sk-ant-...  (requiere: pip install anthropic)   IA_MODELO=claude-opus-5-5  (si lo dejas vacio usa ese)
IA_MODO=
IA_URL=
IA_MODELO=
IA_CLAVE=
IA_TIMEOUT_SEGUNDOS=25
# Archivo con el historial de preguntas del asistente (vacio = data/historial_asistente.jsonl)
ASISTENTE_HISTORIAL=

# --- Stock VTEX: por defecto se usa la consulta oficial (ultima foto de bi_vtex_stock, bodega 1_1, + maestra). STOCK_TABLA solo si quieres leer otra tabla ---
# STOCK_TABLA=dbo.bi_stock_vtex
# STOCK_ORIGEN=sap
# STOCK_COL_SKU=codigoSap
# STOCK_COL_VTEX=VTEX
# STOCK_COL_RESERVADO=Reservado
# --- La IA explica las cifras ya calculadas (a la IA solo salen cifras agregadas; requiere IA_MODO) ---
# IA_REDACTAR=1

# ============ SEGURIDAD (ver SEGURIDAD.md) ============
# Usuarios del tablero: correo:hash:rol separados por punto y coma (rol = lector | analista | admin).
# Crea cada linea con:  python seguridad_admin.py usuario correo@empresa.cl analista
# DASH_USUARIOS=
# Firma de las sesiones (minimo 32 caracteres; obligatoria en Vercel). Genera una con: python seguridad_admin.py claves
# SESSION_SECRET=
# AUTH_REQUERIDA=auto            # auto = exigido si hay usuarios o datos reales en Vercel | 1 | 0
# SESION_HORAS=8
# --- Carga de datos a Vercel sin exponer las bases: el agente publica un paquete cifrado, Vercel solo lo lee ---
# SNAPSHOT_KEYS=                 # clave(s) de cifrado (python seguridad_admin.py claves); varias separadas por coma = rotacion
# BLOB_READ_WRITE_TOKEN=         # Vercel Blob (Storage > Blob); tambien en las variables de Vercel
# SNAPSHOT_DIR=                  # alternativa: carpeta local o compartida
# ALERTA_WEBHOOK=                # Teams/Slack: avisa si falla o se rechaza una publicacion
# AUDITORIA_ARCHIVO=             # por defecto data/auditoria.jsonl
