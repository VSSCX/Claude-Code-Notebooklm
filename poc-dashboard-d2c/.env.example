# ===== Servidor VTEX (Azure) =====
VTEX_SERVER=elxa3sql-customerdata-001.database.windows.net
VTEX_DB=Alfred-Cloud
# Azure NO acepta cuenta de Windows: usuario y clave son obligatorios.
VTEX_USER=
VTEX_PASS=

# ===== Servidor SAP (ODS) =====
SAP_SERVER=clws0156
SAP_DB=161221_ts_ods
# Si el ODS usa tu cuenta de Windows, deja estos dos vacíos.
SAP_USER=
SAP_PASS=

# ===== General =====
FECHA_VALIDADA=2026-07-14
# Revisa "Orígenes de datos ODBC" para saber cuál tienes (17 o 18).
ODBC_DRIVER=ODBC Driver 17 for SQL Server
# DEMO=1 usa datos de ejemplo, sin conexión a SQL.
DEMO=

# ===== Actualizacion en vivo (opcional: estos valores ya son los de fabrica) =====
# Cada cuantos segundos el servidor revisa si entro un pedido nuevo o cambio algo
# (consulta liviana, solo conteos). Mas bajo = se ve mas rapido, pero consulta mas las bases.
REVISAR_CADA_SEGUNDOS=10
# Cada cuantos segundos el navegador pregunta al servidor si hay datos nuevos (no toca las bases).
NAVEGADOR_SEGUNDOS=2
# Recarga completa de respaldo, aunque no se detecte ningun cambio.
RECARGA_MAXIMA_SEGUNDOS=300
# Cuanto tiempo un pedido nuevo se muestra marcado como NUEVO en la tabla.
NUEVO_SEGUNDOS=300
