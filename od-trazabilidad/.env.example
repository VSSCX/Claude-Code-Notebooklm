# Base de datos. Por defecto: SQLite en data\trazabilidad.db
# DATABASE_URL=mssql+pyodbc://usuario:clave@SERVIDOR/Trazabilidad?driver=ODBC+Driver+17+for+SQL+Server

# ---------------------------------------------------------------------------
# SQL Server de las bases (plan de ventas, saldos), solo lectura.
#
# Si todo el equipo usa el MISMO usuario de SQL Server, puedes dejarlo escrito
# aquí antes de repartir el instalador: cada PC lo toma solo y nadie tiene que
# configurar nada. Ojo: la clave queda en texto plano dentro del instalador y de
# cada equipo, así que hazlo solo con un usuario de SOLO LECTURA.
#
# Si en cambio cada persona entra con su cuenta de Windows, deja estas líneas
# comentadas: es lo más seguro y no hay clave que repartir.
# ---------------------------------------------------------------------------
# Si tu PC tiene el Driver 18 en vez del 17, cambia el numero en la linea de abajo.
# Con cuenta de Windows:
# BASES_URL=mssql+pyodbc://SERVIDOR/BASE?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# Si la base usa un usuario propio de SQL Server (no tu cuenta de Windows):
# BASES_USUARIO=usuario
# BASES_CLAVE=clave

# Maestra de homologación (descripciones). Por defecto:
# MAESTRA_HOMOLOGACION=\\clws0088\userelux\SalesOP\Bases Order Desk\MAESTRA HOMOLOGACION.xlsx

# Clave para entrar a la plataforma (déjala vacía si corre solo en tu PC)
# CLAVE_ACCESO=

# Carpeta del visor 3D (plantilla + librerías). Por defecto, la de la red:
# VISOR_ASSETS=\\clws0088\userelux\SalesOP\Bases Order Desk\Proyecto de Automatización\Rutas\Visor

# Libro de automatización (solo Windows)
MACROS_WORKBOOK=V:\SalesOP\Bases Order Desk\Vicente S_Proy Automatización.xlsm

# Acciones que la plataforma puede ejecutar. Si se omite, quedan todas las no destructivas.
# Para habilitar el borrado en SAP hay que agregar eliminar_entrega a mano.
ACCIONES_HABILITADAS=actualizar_bases,cubicar,simular,visor,leer_pedido,crear_entregas,crear_grupos,limpiar
